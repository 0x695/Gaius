// SPDX-License-Identifier: GPL-3.0-or-later
// Gaius -- apps/viewer/gaius.rc: the Windows resources of gaius_viewer.exe: its icon (the one Explorer, the taskbar
// and Alt+Tab show; SDL's window class uses icon 1 too) and the name Task Manager and file properties show.
// The icon is drawn by packaging/icon/make_icon.py.

#include <winver.h>

1 ICON "../../packaging/icon/gaius.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEFLAGSMASK 0x3fL
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "The Gaius contributors"
            VALUE "FileDescription", "Gaius"
            VALUE "InternalName", "gaius_viewer"
            VALUE "LegalCopyright", "GPL-3.0-or-later"
            VALUE "OriginalFilename", "gaius_viewer.exe"
            VALUE "ProductName", "Gaius"
            VALUE "ProductVersion", "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
