#pragma once

namespace gaius {

// What the program calls itself: "0.9.0" on a release build, "0.9.0-dev+abc1234" anywhere else.
inline constexpr const char* kVersion = "@GAIUS_VERSION_STRING@";
// The number alone, as VERSION holds it.
inline constexpr const char* kVersionNumber = "@PROJECT_VERSION@";
inline constexpr int kVersionMajor = @PROJECT_VERSION_MAJOR@;
inline constexpr int kVersionMinor = @PROJECT_VERSION_MINOR@;
inline constexpr int kVersionPatch = @PROJECT_VERSION_PATCH@;

}  // namespace gaius
