// SPDX-License-Identifier: GPL-3.0-or-later
// Gaius -- apps/viewer/gaius.rc.in (CMake writes gaius.rc from it, with the version from the VERSION.txt file): the Windows resources of gaius_viewer.exe: its icon (the one Explorer, the taskbar
// and Alt+Tab show; SDL's window class uses icon 1 too) and the name Task Manager and file properties show.
// The icon is drawn by packaging/icon/make_icon.py.

#include <winver.h>

1 ICON "@PROJECT_SOURCE_DIR@/packaging/icon/gaius.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @GAIUS_VERSION_RC@
PRODUCTVERSION @GAIUS_VERSION_RC@
FILEFLAGSMASK 0x3fL
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "0x"
            VALUE "FileDescription", "Gaius"
            VALUE "InternalName", "gaius"
            VALUE "LegalCopyright", "Copyright (C) 2026 0x. GPL-3.0-or-later"
            VALUE "OriginalFilename", "gaius.exe"
            VALUE "ProductName", "Gaius"
            VALUE "FileVersion", "@GAIUS_VERSION_STRING@"
            VALUE "ProductVersion", "@GAIUS_VERSION_STRING@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
